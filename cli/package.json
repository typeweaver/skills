{
  "name": "equip-it",
  "version": "0.1.2",
  "description": "Skill your agents: install opinionated software-engineering skills and agent adapters for Claude Code, Codex, OpenCode, and Kiro",
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "installer",
    "kiro",
    "opencode"
  ],
  "homepage": "https://github.com/typeweaver/skills",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeweaver/skills.git",
    "directory": "cli"
  },
  "bin": {
    "equip-it": "dist/bin/equip-it.js"
  },
  "files": [
    "dist/bin",
    "content"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "bundle": "tsdown",
    "bundle-content": "node dist/src/bundle-content.js",
    "clean": "node scripts/clean.mjs",
    "prepack": "pnpm build && pnpm bundle && node dist/src/bundle-content.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
